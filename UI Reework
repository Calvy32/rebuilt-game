        .controls-wrapper-left { left: 8px; }
        .controls-wrapper-right { right: 8px; }
        
        /* Scrollbar */
        .controls-wrapper-left::-webkit-scrollbar,
        .controls-wrapper-right::-webkit-scrollbar { width: 4px; }
        .controls-wrapper-left::-webkit-scrollbar-thumb,
        .controls-wrapper-right::-webkit-scrollbar-thumb { background: #555; border-radius: 4px; }

        /* Collapsible panels */
        .controls-panel {
            background: rgba(10, 10, 12, 0.85);
