            font-size: 0.55rem;
            font-weight: 800;
            letter-spacing: 2px;
            color: #aaa;
            margin-top: 2px;
        }
        #phase-timer {
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 1px;
            margin-top: 2px;
