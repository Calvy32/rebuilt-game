function handleGamepadDisconnected(e) { gamepads[e.gamepad.index] = null; updateGamepadStatusUI(); }
function updateGamepadStatusUI() {
    const connected = gamepads.map((gp, i) => gp ? `🎮 ${i}` : `❌ ${i}`).join(' ');
    const msg = `Gamepads: ${connected} | P2:GP${p2GamepadIndex} P4:GP${p4GamepadIndex}`;
    ['gp-status-red','gp-status-blue'].forEach(id => { const el = document.getElementById(id); if (el) el.innerText = msg; });
}
function addGamepadAssignButtons() {
    const redPanel = document.getElementById('control-panel-red');
    if (redPanel && !document.getElementById('p2-gamepad-assign')) {
        const gpStatusRed = document.createElement('div');
        gpStatusRed.id = 'gp-status-red';
        gpStatusRed.style.cssText = 'font-size:0.5rem;color:#aaa;margin-top:4px;text-align:center;';
        document.getElementById('panel-content-red').appendChild(gpStatusRed);
        const p2Btn = document.createElement('button');
        p2Btn.id = 'p2-gamepad-assign';
        p2Btn.className = 'red-team';
        p2Btn.style.fontSize = '0.5rem';
        p2Btn.innerHTML = `P2 GP: ${p2GamepadIndex}`;
        p2Btn.onclick = () => {
            p2GamepadIndex = (p2GamepadIndex + 1) % 4;
            p2Btn.innerHTML = `P2 GP: ${p2GamepadIndex}`;
            updateGamepadStatusUI();
        };
        const p2InputBtn = document.getElementById('p2-input-toggle');
        if (p2InputBtn) p2InputBtn.parentNode.insertBefore(p2Btn, p2InputBtn.nextSibling);
    }
    const bluePanel = document.getElementById('control-panel-blue');
    if (bluePanel && !document.getElementById('p4-gamepad-assign')) {
        const gpStatusBlue = document.createElement('div');
        gpStatusBlue.id = 'gp-status-blue';
        gpStatusBlue.style.cssText = 'font-size:0.5rem;color:#aaa;margin-top:4px;text-align:center;';
        document.getElementById('panel-content-blue').appendChild(gpStatusBlue);
        const p4Btn = document.createElement('button');
        p4Btn.id = 'p4-gamepad-assign';
        p4Btn.className = 'blue-team';
        p4Btn.style.fontSize = '0.5rem';
        p4Btn.innerHTML = `P4 GP: ${p4GamepadIndex}`;
        p4Btn.onclick = () => {
            p4GamepadIndex = (p4GamepadIndex + 1) % 4;
            p4Btn.innerHTML = `P4 GP: ${p4GamepadIndex}`;
            updateGamepadStatusUI();
        };
        const p4InputBtn = document.getElementById('p4-input-toggle');
        if (p4InputBtn) p4InputBtn.parentNode.insertBefore(p4Btn, p4InputBtn.nextSibling);
    }
    updateGamepadStatusUI();
}

function formatTime(s) { s = Math.max(0, Math.ceil(s)); let m = Math.floor(s / 60), sec = s % 60; return m + ":" + (sec < 10 ? "0" : "") + sec; }
function getDisplayTime(elapsed) {
    if (elapsed <= 20) return formatTime(20 - elapsed);
    if (elapsed <= 23) return formatTime(23 - elapsed);
    if (elapsed <= 163) return formatTime(163 - elapsed);
    return "0:00";
}
function triggerShiftFlash() { const el = document.getElementById('shift-flash'); el.classList.add('flash'); setTimeout(() => el.classList.remove('flash'), 200); }
